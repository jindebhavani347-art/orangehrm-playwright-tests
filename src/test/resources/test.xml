<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Playwright Test Suite" verbose="1">

    <!-- Step 1: Run Setup -->
    <test name="Setup-Environment">
        <classes>
            <class name="aa_setup.aa_stup" />
        </classes>
    </test>

    <!-- Step 2: Automatically run ALL test classes inside com.consoletest.config -->
    <test name="Functional-Tests">
        <packages>
            <package name="com.consoletest.config.*" />
        </packages>
    </test>
    <!-- Step 3: Run Teardown -->
    <test name="Teardown-Environment">
        <classes>
            <class name="zz_setup.zz_down" />
        </classes>
    </test>

</suite>